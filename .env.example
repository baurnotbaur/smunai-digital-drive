# По умолчанию форма заявки на /cards шлёт заявки на прод-CRM
# (https://smunai-lead-service.vercel.app, база на Turso).
# Чтобы при локальной разработке заявки уходили в локальный lead-service,
# скопируйте этот файл в .env и раскомментируйте строки ниже.
# Ключ берётся в панели CRM: раздел «Подключение сайта».

# VITE_LEAD_SERVICE_URL=http://localhost:4000
# VITE_LEAD_SITE_KEY=ключ_локальной_базы
